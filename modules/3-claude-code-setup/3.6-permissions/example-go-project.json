{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(go build ./...)",
      "Bash(go vet ./...)",
      "Bash(go mod tidy)",
      "Bash(golangci-lint *)",
      "Bash(make *)"
    ],
    "deny": [
      "Bash(go run *)",
      "Bash(go install *)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  }
}
