{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(pip install -r requirements*.txt)",
      "Bash(ruff check *)",
      "Bash(mypy *)"
    ],
    "deny": [
      "Bash(pip install --user *)",
      "Bash(python -c *)",
      "Bash(pip install *)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*secret*)"
    ]
  }
}
