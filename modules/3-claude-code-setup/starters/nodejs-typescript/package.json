{
  "name": "agentic-engineering-nodejs-typescript-starter",
  "version": "0.1.0",
  "description": "Module 3 starter: Node.js + TypeScript + Express з Claude Code production-ready конфігом",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts || echo 'No tests yet'",
    "lint": "eslint src --ext .ts || echo 'eslint not installed'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
