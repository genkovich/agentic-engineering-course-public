#!/usr/bin/env bash
# Pre-commit hook для демо 7.6 — обов'язковий базовий рівень.
# Ганяє типи + тести; падає хоч одне — коміт скасовується (git перериває на ненульовому коді).
#
# Встановити (демо лежить у монорепо, тож НЕ копіюємо в кореневий .git/hooks наосліп):
#   make install-hooks        # вкаже git на цей скрипт через core.hooksPath
# або вручну для запису скринкасту — прогнати як звичайний скрипт:
#   bash scripts/pre-commit   # exit 0 = зелено, exit 1 = червоно (коміт би заблокувався)
#
# Чесна примітка: демо — піддиректорія монорепо agentic-engineering-course. Справжній
# .git/hooks/pre-commit спрацював би на КОРЕНІ монорепо. Для самодостатнього демо запускай
# цей скрипт вручну (показує ту саму перевірку) або зроби демо окремим git-репо для запису.

set -euo pipefail
cd "$(dirname "$0")/.."

echo "▶ pre-commit gate: npx tsc --noEmit && npm test"
npx tsc --noEmit && npm test
echo "✅ gate зелений — коміт дозволено"
