{
  "permissions": {
    "defaultMode": "manual",
    "allow": [
      "Read",
      "Edit",
      "Bash(git status:*)",
      "Bash(python3 scripts/agent_sim.py:*)",
      "WebFetch(domain:docs.internal.example)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/guard.sh"
          }
        ]
      }
    ]
  }
}
