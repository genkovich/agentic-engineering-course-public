# source цей файл перед запуском claude, щоб телеметрія пішла в локальний стек.
#   source claude-otel.env && claude
# Зміни team.id між сесіями (backend-a → backend-b), щоб побачити per-team розбивку.

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Прискорюємо експорт для демо (у проді: метрики 60000, логи 5000).
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Командна сегментація - ця мітка стає team_id у Prometheus/Grafana.
export OTEL_RESOURCE_ATTRIBUTES=team.id=backend-a,department=engineering
