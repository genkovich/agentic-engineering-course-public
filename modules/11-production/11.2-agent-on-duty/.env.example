# Розкладка секретів чергового агента.
# Скопіюй у .env поруч із compose.yml і заповни своїми значеннями.
# .env живе ТІЛЬКИ на сервері: він не потрапляє ні в git, ні в Docker-образ.

# Серверний API-ключ з Anthropic Console з виставленим лімітом витрат.
# Ключ підписки (claude setup-token) на сервер не їде.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub fine-grained personal access token, обмежений ОДНИМ репозиторієм:
# Contents Read/Write, Issues Read/Write, Pull requests Read/Write.
GH_TOKEN=github_pat_...

# Секрет вебхука: той самий рядок, що вписаний у налаштуваннях webhook
# репозиторію. Ним GitHub підписує кожен payload (X-Hub-Signature-256).
WEBHOOK_SECRET=

# Репозиторій, який обслуговує черговий.
COURSE_REPO=genkovich/course-project
