{
  "permissions": {
    "allow": [
      "Bash(node serve.mjs:*)",
      "Bash(node:*)",
      "Bash(bash init.sh:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pkill -f serve.mjs)",
      "mcp__playwright__*"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
