{
  "name": "stage-3-hexagonal",
  "version": "0.1.0",
  "description": "TS stage-3-hexagonal — full hexagonal per BC, dependency-cruiser arch tests, in-memory event bus",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "fastify": "4.29.1",
    "pg": "8.23.0",
    "bcryptjs": "2.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/bcryptjs": "2.4.6",
    "dependency-cruiser": "16.10.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
