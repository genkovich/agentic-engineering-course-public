{
  "name": "stage-3-hexagonal",
  "version": "0.1.0",
  "description": "TS stage-3-hexagonal — full hexagonal per BC, dependency-cruiser arch tests, in-memory event bus",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
