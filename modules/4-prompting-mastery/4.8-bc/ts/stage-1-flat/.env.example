# Скопіюй у .env, якщо 5432 або 8080 вже зайняті:
#   cp .env.example .env
# Цей файл читають і make, і docker compose — порт треба змінити лише тут.
# Разова альтернатива без файлу: make db-up PGPORT=5433

PGPORT=5432
HTTP_PORT=8080

# DATABASE_URL і HTTP_ADDR make збирає з PGPORT/HTTP_PORT сам.
# Розкоментуй, тільки якщо потрібен зовсім інший DSN:
# DATABASE_URL=postgres://demo:demo@localhost:5432/demo
