# Порт HTTP-сервера (webhook receiver + MCP endpoint)
PORT=3334

# Секрет для перевірки підпису webhook.
# GitHub: заголовок X-Hub-Signature-256 (HMAC SHA-256 від body).
# GitLab: заголовок X-Gitlab-Token (просте порівняння).
# Якщо порожньо, сервер приймає webhooks без перевірки і пише warning у лог.
WEBHOOK_SECRET=

# Telegram Bot API для send_notification.
# Якщо порожньо, tool працює у dry-run режимі:
# повідомлення йде у лог і у data/sent.json, у Telegram нічого не летить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
