  "TELEGRAM_BOT_TOKEN": "REPLACE_ME_123456:ABC-DEF...",
  "TELEGRAM_CHAT_ID": "REPLACE_ME_-1001234567890",
  "MCP_ALLOWLIST": "mcp__filesystem,mcp__memory"
}
